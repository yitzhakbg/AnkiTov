#!/bin/bash
# AnkiTov single-app s6 service: Anki is the only session client.
# Backend-aware. X11: Xvfb framebuffer, no window manager (we size the window
# ourselves). Wayland: Anki renders through the nested labwc session compositor
# inside Selkies' Smithay capture compositor (QT_QPA_PLATFORM=wayland); labwc
# maximises it via window rule, so no xdotool.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091
. "${XDG_RUNTIME_DIR}/container-env"
export PYTHONPATH=/stream:/opt/anki/app_packages:/opt/anki/python/lib/python3.13
export PYTHONUNBUFFERED=1
export PYTHONFAULTHANDLER=1
# clear a stale single-instance socket so a restart cannot silently no-op
rm -f /tmp/anki* 2>/dev/null || true

# Wayland socket liveness probe (a stale socket file outlives its compositor)
wl_live() {
  python3 -c 'import socket,sys
s=socket.socket(socket.AF_UNIX)
try:
    s.connect(sys.argv[1])
    s.close()
except OSError:
    sys.exit(1)' "$1" 2>/dev/null
}

if [ "${SELKIES_WAYLAND:-false}" = "true" ]; then
  # The wayland service records the CAPTURE compositor's socket in this file.
  # The session compositor (labwc) owns whichever other socket answers.
  WAYLAND_DISPLAY=""
  if [ "${SELKIES_WAYLAND_COMPOSITOR:-none}" != "none" ]; then
    for _ in $(seq 1 480); do
      cap="$(cat "${XDG_RUNTIME_DIR}/selkies-capture-display" 2>/dev/null)"
      if [ -n "${cap}" ]; then
        for s in "${XDG_RUNTIME_DIR}"/wayland-[0-9]*; do
          [ -S "$s" ] || continue
          n="${s##*/}"
          [ "$n" = "$cap" ] && continue
          wl_live "$s" || continue
          WAYLAND_DISPLAY="$n"
          break
        done
      fi
      [ -n "${WAYLAND_DISPLAY}" ] && break
      sleep 0.5
    done
  fi
  if [ -n "${WAYLAND_DISPLAY}" ]; then
    export WAYLAND_DISPLAY
    export QT_QPA_PLATFORM=wayland
    export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
    export XDG_SESSION_TYPE=wayland
    echo "[anki] Wayland session socket: ${WAYLAND_DISPLAY}" >&2
  else
    # No session socket (compositor "none", or it never came up): fall to XWayland.
    echo "[anki] no Wayland session socket; using X11/XWayland" >&2
    export DISPLAY="${DISPLAY:-:0}"
  fi
else
  export DISPLAY="${DISPLAY:-:20}"
  XNUM="${DISPLAY#:}"
  for _ in $(seq 1 240); do [ -S "/tmp/.X11-unix/X${XNUM}" ] && break; sleep 0.5; done
fi

/opt/anki/python/bin/python3 -u /stream/boot.py -b /home/ubuntu/.local/share/Anki2 &
ANKI=$!
# make s6-svc -r / docker stop actually reap Anki (no orphans)
trap 'kill -TERM "$ANKI" 2>/dev/null' TERM INT EXIT

# X11 backend only: no window manager, so size/position the MAIN window ourselves
# (WM_CLASS "Anki" + _NET_WM_WINDOW_TYPE_NORMAL; not popups/selection owners).
if [ "${QT_QPA_PLATFORM:-}" != "wayland" ]; then
  (
    for _ in $(seq 1 300); do
      for W in $(xdotool search --name 'Anki' 2>/dev/null); do
        xprop -id "$W" WM_CLASS 2>/dev/null | grep -q '"Anki"' || continue
        T="$(xprop -id "$W" _NET_WM_WINDOW_TYPE 2>/dev/null)"
        echo "$T" | grep -q '_NET_WM_WINDOW_TYPE_NORMAL' || continue
        echo "$T" | grep -q 'POPUP_MENU' && continue
        xdotool windowsize "$W" 1920 1080 2>/dev/null || true
        xdotool windowmove "$W" 0 0 2>/dev/null || true
        xdotool windowraise "$W" 2>/dev/null || true
        break 2
      done
      sleep 1
    done
  ) &
fi

wait "$ANKI"
