{
    "id": "org.ankitov.AnkiTov",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "ankitov-launch",
    "finish-args": [
        "--share=network",
        "--filesystem=home",
        "--device=dri",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "modules": [
        {
            "name": "ankitov",
            "buildsystem": "simple",
            "build-commands": [
                "tar xzf ankitov-linux-${ARCH}.tar.gz",
                "install -Dm755 backend /app/bin/backend",
                "install -Dm755 ankitov-launch /app/bin/ankitov-launch",
                "install -Dm644 packaging/flatpak/org.ankitov.AnkiTov.desktop /app/share/applications/org.ankitov.AnkiTov.desktop",
                "desktop-file-validate /app/share/applications/org.ankitov.AnkiTov.desktop",
                "install -Dm644 packaging/linux/ankitov.desktop /app/share/applications/org.ankitov.AnkiTov.desktop"
            ],
            "sources": [
                {
                    "type": "file",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "file://ankitov-linux-x86_64.tar.gz",
                    "dest-filename": "ankitov-linux-x86_64.tar.gz"
                },
                {
                    "type": "file",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "file://ankitov-linux-aarch64.tar.gz",
                    "dest-filename": "ankitov-linux-aarch64.tar.gz"
                },
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}