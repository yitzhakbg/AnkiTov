{
    "id": "org.ankitov.AnkiTov",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "ankitov-launch",
    "finish-args": [
        "--share=network",
        "--filesystem=home",
        "--device=dri",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "modules": [
        {
            "name": "ankitov",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p approot && tar xzf ankitov-linux-x86_64.tar.gz --no-same-owner -C approot --strip-components=1",
                "install -Dm755 approot/backend /app/bin/backend",
                "install -Dm755 approot/ankitov-launch /app/bin/ankitov-launch",
                "mkdir -p /app/bin/config",
                "install -Dm644 approot/config/production.yaml /app/bin/config/production.yaml",
                "mkdir -p /app/bin/content/seed",
                "cp -R approot/content/seed/packages /app/bin/content/seed/packages",
                "mkdir -p /app/share/applications",
                "printf '[Desktop Entry]\\nType=Application\\nName=AnkiTov\\nExec=ankitov-launch\\nTerminal=false\\nCategories=Education;\\n' > /app/share/applications/org.ankitov.AnkiTov.desktop"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "ankitov-linux-x86_64.tar.gz",
                    "dest-filename": "ankitov-linux-x86_64.tar.gz"
                },
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        "ankitov-linux-x86_64.tar.gz"
                    ]
                }
            ]
        }
    ]
}