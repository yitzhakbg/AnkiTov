#!/bin/sh
# AnkiTov one-step commissioning (T-207) — shared by the .deb postinst and the
# .rpm %post (fpm --after-install). MUST stay distro-agnostic /bin/sh: the
# deb/rpm pair is built from the same staged payload and must not drift.
#
# First install:  create the `ankitov` system user, generate the JWT secret
#                 env file (0600, never overwritten), enable + start the unit.
# Upgrade:        preserve /etc/ankitov + /var/lib/ankitov, restart the unit so
#                 the new binary runs.
# Non-systemd hosts (e.g. plain docker without an init): systemctl calls are
# skipped with a loud note — install succeeds, commissioning is manual.
set -eu

SERVICE=ankitov
ENV_DIR=/etc/ankitov
ENV_FILE="$ENV_DIR/ankitov.env"
STATE_DIR=/var/lib/ankitov

note() { printf 'ankitov: %s\n' "$1"; }

# ---------------------------------------------------------------------------
# 1. System user (idempotent). useradd exists on Debian and RHEL alike.
# ---------------------------------------------------------------------------
if ! getent passwd "$SERVICE" >/dev/null 2>&1; then
    useradd --system --user-group \
        --home-dir "$STATE_DIR" --no-create-home \
        --shell /usr/sbin/nologin "$SERVICE" 2>/dev/null \
    || adduser --system --group \
        --home "$STATE_DIR" --no-create-home --shell /usr/sbin/nologin "$SERVICE" 2>/dev/null \
    || note "WARNING: could not create system user $SERVICE — unit will fail to start"
fi

# ---------------------------------------------------------------------------
# 2. Secret env file — generated on FIRST INSTALL only, never overwritten.
#    systemd (root) parses EnvironmentFile before dropping privileges, so the
#    file stays root:root 0600; the service process never reads it directly.
# ---------------------------------------------------------------------------
if [ ! -f "$ENV_FILE" ]; then
    mkdir -p "$ENV_DIR"
    if command -v openssl >/dev/null 2>&1; then
        SECRET=$(openssl rand -hex 32)
    else
        SECRET=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
    fi
    {
        printf '# Generated by the ankitov package postinst on first install.\n'
        printf '# NEVER regenerated on upgrade — deleting this file rotates the JWT\n'
        printf '# secret and signs every existing session out.\n'
        printf 'ANKITOV_JWT_SECRET=%s\n' "$SECRET"
    } > "$ENV_FILE"
    chmod 0600 "$ENV_FILE"
    note "generated $ENV_FILE (0600) with a fresh JWT secret"
else
    note "keeping existing $ENV_FILE (upgrade — secret preserved)"
fi

# ---------------------------------------------------------------------------
# 3. Config visibility: the backend resolves its config folder CWD-relative
#    (loco-rs Config::new -> ./config), so the state dir gets a symlink to the
#    package-owned config. -sfn is idempotent across upgrades. Fails soft if a
#    real directory occupies the name (operator-managed config) — the unit
#    then uses that directory as-is.
# ---------------------------------------------------------------------------
if [ ! -e "$STATE_DIR/config" ] && [ ! -L "$STATE_DIR/config" ]; then
    mkdir -p "$STATE_DIR"
    ln -s /opt/ankitov/config "$STATE_DIR/config" 2>/dev/null \
        || note "could not symlink $STATE_DIR/config -> /opt/ankitov/config"
fi

# ---------------------------------------------------------------------------
# 4. systemd commissioning.
# ---------------------------------------------------------------------------
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable "$SERVICE" >/dev/null 2>&1 || true
    if systemctl is-active --quiet "$SERVICE"; then
        # Upgrade (or reconfigure) with the service already running: restart so
        # the newly unpacked binary takes over. Data in /var/lib/ankitov and
        # the secret in /etc/ankitov are untouched.
        systemctl restart "$SERVICE" || note "WARNING: restart failed — check systemctl status $SERVICE"
        note "service restarted"
    else
        systemctl start "$SERVICE" || note "WARNING: start failed — check systemctl status $SERVICE"
        note "service started (enabled at boot)"
    fi
else
    note "systemd not active — skipping auto-start; run manually with:"
    note "  systemctl daemon-reload && systemctl enable --now $SERVICE"
fi

exit 0
