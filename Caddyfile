# Caddy reverse proxy configuration for AnkiTov
#
# Caddy handles:
#   - Automatic HTTPS via Let's Encrypt / ZeroSSL for app.ankitov.com
#   - Reverse proxying to backend API, Management Console, and PWA
#   - WebSocket support for real-time telemetry / streaming
#
# Domain defaults to app.ankitov.com (can be overridden via ANKITOV_DOMAIN env var)

{$ANKITOV_DOMAIN:app.ankitov.com} {
    # ── Security Headers ──
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # ── Gzip / Zstandard Compression ──
    encode zstd gzip

    # ── Health Probes ──
    handle /health {
        reverse_proxy backend:5150
    }

    # ── API endpoints ──
    handle /api/* {
        reverse_proxy backend:5150
    }

    # ── Management Console & PWA Routes ──
    handle /dashboard/* {
        reverse_proxy backend:5150
    }
    handle /imp-console* {
        reverse_proxy backend:5150
    }
    handle /locales/* {
        reverse_proxy backend:5150
    }
    handle /vendor/* {
        reverse_proxy backend:5150
    }
    handle /i18n.js {
        reverse_proxy backend:5150
    }
    handle /rtl.css {
        reverse_proxy backend:5150
    }

    # ── Default Fallback: Route to Loco.rs App ──
    handle {
        reverse_proxy backend:5150
    }

    # ── Structured JSON Access Logging ──
    log {
        output stdout
        format json
    }
}
