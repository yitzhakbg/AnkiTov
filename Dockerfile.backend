# AnkiTov Loco.rs Backend Container
# Multi-stage build for minimal production image

# ── Build Stage ──
FROM rust:bookworm AS builder

WORKDIR /build

# Install build dependencies (OpenSSL, SQLite, build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev libsqlite3-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy backend source
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src ./src
COPY backend/config ./config
COPY backend/resources ./resources
COPY backend/i18n ./i18n

# Build release binary
RUN cargo build --release --locked

# ── Runtime Stage ──
FROM debian:trixie-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 libsqlite3-0 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 ankitov && \
    useradd -u 1000 -g ankitov -d /app -s /bin/bash ankitov

# Copy binary & assets from builder
COPY --from=builder /build/target/release/backend /app/ankitov-backend
COPY backend/config /app/config
COPY backend/resources /app/resources
COPY backend/i18n /app/i18n

# Create directories for logs and data
RUN mkdir -p /app/logs /app/data /etc/ankitov && \
    chown -R ankitov:ankitov /app /etc/ankitov

USER ankitov

ENV LOCO_ENV=production
ENV RUST_LOG=info

EXPOSE 5150

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5150/health || exit 1

CMD ["/app/ankitov-backend", "start"]
